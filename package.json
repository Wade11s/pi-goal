{
	"name": "pi-goal",
	"version": "0.1.1",
	"description": "Codex-style persistent Goals for Pi: /goal command plus get_goal, create_goal, and update_goal model tools, with automatic continuation at Pi's safe settlement boundary",
	"type": "module",
	"license": "MIT",
	"author": "Wade11s",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Wade11s/pi-goal.git"
	},
	"homepage": "https://github.com/Wade11s/pi-goal#readme",
	"bugs": {
		"url": "https://github.com/Wade11s/pi-goal/issues"
	},
	"keywords": [
		"pi-package",
		"pi",
		"goal",
		"automation"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"test": "node --test --test-concurrency=4 \"test/*.test.mjs\"",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.5.1",
		"@earendil-works/pi-coding-agent": "1.5.1",
		"@types/node": "^24.0.0",
		"typebox": "1.3.27",
		"typescript": "^5.7.0"
	}
}
