{
  "name": "pi-rex-subagent",
  "version": "0.2.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "description": "Pi subagents that run as Rex terminal windows instead of tmux sessions",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "test:live": "REX_SUBAGENT_LIVE=1 node --test tests/live.smoke.test.ts"
  },
  "bin": {
    "rex-subagent": "./src/cli.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "typebox": "1.3.27"
  }
}
